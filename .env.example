# ──────────────────────────────────────────────
# PDF-GPT — Environment Configuration Template
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────
# Get your free API key from Google AI Studio:
#   https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_api_key_here

# ── Optional — Model Selection ────────────────
# Gemini models: gemini-2.0-flash, gemini-1.5-pro, gemma-4-31b-it
GEMINI_MODEL=gemini-2.0-flash

# Embedding model for Google API (fallback: local FastEmbed)
EMBEDDINGS_MODEL=models/gemini-embedding-2
